# Aliases

# ls
alias ls='ls --color=auto'
alias ll='ls -lah'
alias lt='ls -lath'

#grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

#CLI
alias c='clear'
alias v='vim'
alias t='tmux'
alias e='exit'
alias n='nvim'

#Directories defined in Environment Variables using export
alias repo='cd $REPOS'
alias dev='cd $DEV'
alias pi='cd $PI'
alias blog='cd $BLOG'
alias home='cd $HOMELAB'
alias github='cd $GITHUB'
alias sb='cd $SECONDBRAIN'
alias clone='cd $CLONE'
alias scr='cd $SCRIPTS'
alias lab='cd $LAB'

#K8S
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgpa='kubectl get pods --all-namespaces'
alias kga='kubectl get all'
alias ksc='kubectl config set-context --current --namespace'
alias kgc='kubectl config get-context'
alias kgn='kubectl get nodes'

#Flux
alias fgk='flux get kustomizations'
alias frk='flux reconcile kustomization'

# Git
alias gaa="git add ."
alias gbr="git branch"
alias gba="git branch -a"
alias gcl="git clone"
alias gcm="git commit -m"
alias gdf="git diff"
alias gpl="git pull"
alias gpu="git push"
alias gsw="git switch"
alias gsc="git switch -c"
alias gst="git status"
